# Voorbeeldbestand. Kopieer dit naar .env.local en vul uw eigen waarden in.
# .env.local staat in .gitignore en komt dus nooit in Git terecht.
# Zet hier nooit een sleutel in een .ts- of .tsx-bestand; alles blijft server-side.

# API-sleutel van Resend (https://resend.com/api-keys). Begint met re_
RESEND_API_KEY=

# Zakelijk adres waar de volledige aanvraag naartoe gaat
CONTACT_EMAIL=

# Afzender van de e-mails. Moet een adres zijn op een domein dat u in Resend
# heeft geverifieerd, bijvoorbeeld website@uwdomein.nl
FROM_EMAIL=
